---
import { Image, getImage } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import BannerCTA from "@components/sections/BannerCTA.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import FAQs from "@components/sections/FAQs.astro";
import Gallery from "@components/sections/Gallery.astro";
import accentImg from "@assets/accent.jpg";
import featuredImg from "@assets/all-cal-4.jpg";
import featuredImg2 from "@assets/group-sing-1.jpg";
import featuredImg3 from "@assets/group-sing-2.jpg";
import featuredImg4 from "@assets/shape-mi.png";
import gallery1 from "@assets/notes-bg-2.jpg";
import gallery2 from "@assets/gallery-2.jpeg";
import gallery3 from "@assets/gallery-3.jpg";
import gallery4 from "@assets/gallery-4.jpg";
import gallery5 from "@assets/gallery-5.jpg";
import gallery6 from "@assets/ShapeNoteA.jpg";
import gallery7 from "@assets/ShapeNote9.jpg";
import gallery8 from "@assets/all-cal-1.png";
import heroImg from "@assets/notes-hero-v2.jpg";
import notesBG from "@assets/notes-bg.jpg";

const title = "Los Angeles Sacred Harp";
const intro =
    "Join us around the Los Angeles area for monthly singings from the Sacred Harp and other shape-note tunebooks. All are welcome; no previous experience or commitment required. Come sing with us!";
const connect = `We welcome you to join us at a singing! Stay updated by joining our <a href="https://groups.google.com/g/fasola-los-angeles-announcements" target="_blank">Google discussion group</a> for notifications (requires a Google account) or the <a href="https://www.facebook.com/groups/523008111164440" target="_blank">Los Angeles Area Shape Note Singers</a> public Facebook group. We recommend you join one of these options for the most current information, as this site is updated only periodically. Alternatively, you can <a href="mailto:losangelessacredharp@gmail.com" target="_blank">contact us</a> directly with questions.`;

const bgImageMain = await getImage({ src: heroImg, format: "webp" });
const bgImageAccent = await getImage({ src: accentImg, format: "webp" });

const singings = await getCollection("singings");
const nav = await getEntry("navs", "home");
---

<BaseLayout id="home">
    <div class="accent-img" style=`--bg-image: url('${bgImageAccent.src}')`>
    </div>
    <section class="home-hero" style={`--bg-image: url('${bgImageMain.src}')`}>
        <div class="content-wrapper">
            <div class="text-wrapper | flow" data-tempo="m">
                <h1>{title}</h1>
                <p class="intro">{intro}</p>
                <nav aria-label="Primary" class="cluster">
                    <ul class="cluster">
                        {
                            nav?.data.entries.map((item) => (
                                <li>
                                    <a href={item.href}>{item.title}</a>
                                </li>
                            ))
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </section>
    <div class="sections">
        <section class="section" data-section="regular-singings" id="singings">
            <div class="content-wrapper">
                <div class="grid-12">
                    <div class="text-wrapper">
                        <h2 class="heading | with-mark">Regular Singings</h2>
                        {singings.sort((a, b) => a.data.order - b.data.order).map(async (item) => {
                            const { Content } = await render(item);
                            return (
                                <div class="block | flow" data-tempo="s">
                                    <h3>{item.data.title}</h3>
                                    <Content />
                                </div>
                            );
                        })}
                    </div>
                    <div class="image-wrapper">
                        <div class="flow" data-tempo="l">
                            <Image
                                alt="Overhead view of a large number of singers at the All-California convention."
                                class="featured-image"
                                format="webp"
                                loading="eager"
                                src={featuredImg}
                                width={900}
                            />
                            <div class="relative">
                                <Image
                                    alt="Four women leading from the hollow square."
                                    class="featured-image offset-left"
                                    format="webp"
                                    loading="eager"
                                    src={featuredImg3}
                                    width={900}
                                />
                                <Image
                                    alt=""
                                    class="featured-image background"
                                    format="webp"
                                    loading="eager"
                                    src={featuredImg4}
                                    width={900}
                                />
                            </div>
                            <Image
                                alt="A shape-note convention with singers facing the hollow square while a leader directs a tune."
                                class="featured-image"
                                format="webp"
                                loading="eager"
                                src={featuredImg2}
                                width={900}
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <BannerCTA
            heading="Connect"
            id="connect"
            image={notesBG}
            text={connect}
        />
        <FAQs />
        <!-- <Gallery images={[
            {src: gallery7},
            {src: gallery1},
            {src: gallery5},
            {src: gallery3},
            {src: gallery4},
            {src: gallery6},
            {src: gallery2},
            {src: gallery8},
        ]} /> -->
    </div>
</BaseLayout>

<style>
    h1 {
        font-size: var(--step-6);
    }

    .home-hero {
        padding-block-start: 14rem;
        font-size: var(--step-1);
        color: var(--brown-4);
        background:
            linear-gradient(to top, rgb(30 64 90 / 96%), rgb(30 64 90 / 25%)),
            var(--bg-image) center / cover no-repeat;

        & nav {
            --cluster-space: var(--space-xs);
            font-size: var(--step-0);

            & ul > * + * {
                &::before {
                    content: "✻";
                    color: var(--brown-8);
                    /* font-size: 20px; */
                    margin-inline-end: var(--cluster-space);
                }
            }

            & a {
                color: var(--brown-4);
            }
        }
    }

    .text-wrapper {
        max-width: 48rem;
        padding-block-end: 4rem;
    }

    .accent-img {
        position: relative;
        z-index: 2;
        width: 100%;
        background: var(--bg-image) center / contain repeat;
        height: 3.5rem;

        /* & img {
            width: 100%;
            height: auto;
            object-fit: cover;
        } */
    }

    .section {
        &[data-section="regular-singings"] {
            overflow: hidden;
            
            & .grid-12 {
                & .text-wrapper {
                    --grid-col-span: span 7;
                }

                & .image-wrapper {
                    --grid-col-span: 9/13;
                    position: relative;
                }
            }
        }
    }

    .block {
        &:not(:first-of-type) {
            margin-block-start: var(--space-m);
            padding-block-start: var(--space-m);
            border-block-start: 1px solid var(--brown-5);
        }
    }

    .heading {
        margin-block-end: var(--space-l);
    }

    .featured-image {
        position: relative;
        border-radius: 4px;

        &.offset-left {
            left: -4rem;
        }

        &.background {
            position: absolute;
            z-index: -1;
            bottom: 0;
            right: -2rem;
            width: 100%;
            transform: scale(1.3);
            /* max-width: 12rem; */
            opacity: 0.4;
            mix-blend-mode: hard-light;
        }
    }

    @media (max-width: 640px) {
        h1 {
            font-size: var(--step-5);
        }

        .section {
            &[data-section="regular-singings"] {
                & .grid-12 {
                    grid-template-columns: 1fr;

                    & .text-wrapper {
                        --grid-col-span: 1/1;
                    }

                    & .image-wrapper {
                        --grid-col-span: 1/1;
                    }
                }
            }
        }

        .panes {
            --panes-gap: var(--space-s);
            --panes-width: 100% !important;

            &[data-composition="diptych"] {
                --panes-width: 100%;

                &[data-image-offset] {
                    & .text-wrapper {
                        --panes-width: 100%;
                    }

                    & .image-wrapper {
                        --panes-width: 100%;
                    }
                }
            }

            & .text-wrapper {
                order: 1;
            }

            & .image-wrapper {
                order: 2;
            }
        }

		& .featured-image {
			&.offset-left {
				left: 0;
		}
    }
</style>
