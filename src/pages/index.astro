---
import { Image, getImage } from "astro:assets";
import BannerCTA from "@components/BannerCTA.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import accentImg from "@assets/accent.jpg";
import featuredImg from "@assets/featured-shapes-1.jpg";
import featuredImg2 from "@assets/all-cal-3.jpg";
import heroImg from "@assets/notes-hero-v2.jpg";
import notesBG from "@assets/notes-bg.jpg";

const title = "Los Angeles Sacred Harp";
const intro =
    "Join us around the Los Angeles area for monthly singings from the Sacred Harp and other shape-note tunebooks. All are welcome; no previous experience or commitment required. Come sing with us!";
const connect = `We welcome you to join us at a singing! Stay updated by joining our <a href="https://groups.google.com/g/fasola-los-angeles-announcements" target="_blank">Google discussion group</a> for notifications (requires a Google account) or the <a href="https://www.facebook.com/groups/523008111164440" target="_blank">Los Angeles Area Shape Note Singers</a> public Facebook group. We recommend you join one of these options for the most current information, as this site is updated only periodically.`;

const bgImageMain = await getImage({ src: heroImg, format: "webp" });
const bgImageAccent = await getImage({ src: accentImg, format: "webp" });
---

<BaseLayout id="home">
    <div class="accent-img" style=`--bg-image: url('${bgImageAccent.src}')`>
    </div>
    <section class="home-hero" style={`--bg-image: url('${bgImageMain.src}')`}>
        <div class="content-wrapper">
            <div class="text-wrapper | flow" data-tempo="m">
                <h1>{title}</h1>
                <p class="intro">{intro}</p>
            </div>
        </div>
    </section>
    <div class="sections">
        <section class="section" data-section="regular-singings" id="singings">
            <div class="content-wrapper">
                <div class="grid-12">
                    <div class="text-wrapper">
                        <h2 class="heading | with-mark">Regular Singings</h2>
                        <div class="block | flow" data-tempo="s">
                            <h3>First Sundays in Eagle Rock</h3>
                            <p>
                                Singings from the 2025 Sacred Harp (Denson) and
                                Shenandoah Harmony are hosted at the O’Leary
                                home in Eagle Rock. Text or call Mary Rose with
                                questions at (323) 695-3020.
                            </p>
                            <p>
                                3:30 pm – 6:00 pm<br />Eagle Rock, Los Angeles
                            </p>
                        </div>
                        <div class="block | flow" data-tempo="s">
                            <h3>Second Saturdays in Mar Vista</h3>
                            <p>
                                Westside Shapenote invites you to sing from the
                                2025 Sacred Harp (Denson) and Shenandoah Harmony
                                in beautiful Mar Vista. Beginners welcome.
                                Questions? Text Peter at (310) 591-7098.
                            </p>
                            <p>
                                2:00 pm – 4:30 pm<br />3986 Berryman Ave, Los
                                Angeles, CA 90066
                            </p>
                        </div>
                        <div class="block | flow" data-tempo="s">
                            <h3>Fourth Saturdays in Pasadena</h3>
                            <p>
                                Join us on the fourth Saturday of every month in
                                Pasadena for singings from the 2025 Sacred Harp
                                (Denson) and Christian Harmony books. Loaners
                                are available for those who don’t have a copy.
                            </p>
                            <p>
                                2:00 pm – 4:30 pm<br /><em
                                    >Orange Grove Friends Meetinghouse</em
                                ><br />520 E. Orange Grove Blvd, Pasadena, CA
                                91104
                            </p>
                        </div>
                        <div class="block flow" data-tempo="s">
                            <h3>✻ Annual All-California Convention</h3>
                            <p>
                                Third Sunday, and the Saturday before, in
                                January. This two-day convention draws singers
                                from all over the state and country and rotates
                                every year between the San Francisco Bay Area
                                and Los Angeles. The next singing will take
                                place in the Bay Area on January 16–17, 2027.
                            </p>
                            <p>
                                <em>
                                    Listen to recordings from the 2026
                                    All-California Convention on YouTube: <a
                                        href="https://www.youtube.com/live/ZGQd6kt-wBo?si=f7IIkubSaibNUlNG"
                                        target="_blank">Saturday singing</a
                                    > & <a
                                        href="https://www.youtube.com/live/VLXRPQ5rcWM?si=5oCl7UY31elMzaG4"
                                        target="_blank">Sunday singing</a
                                    >
                                </em>
                            </p>
                        </div>
                    </div>
                    <div class="image-wrapper">
                        <div class="flow" data-tempo="xl">
                            <Image
                                alt=""
                                class="featured-image"
                                format="webp"
                                loading="eager"
                                src={featuredImg}
                                width={900}
                            />
                            <Image
                                alt=""
                                class="featured-image"
                                format="webp"
                                loading="eager"
                                src={featuredImg2}
                                width={900}
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <BannerCTA
            heading="Connect"
            id="connect"
            image={notesBG}
            text={connect}
        />
    </div>
</BaseLayout>

<style>
    h1 {
        font-size: var(--step-6);
    }

    .home-hero {
        padding-block-start: 14rem;
        color: var(--brown-4);
        background:
            linear-gradient(to top, rgb(30 64 90 / 96%), rgb(30 64 90 / 25%)),
            var(--bg-image) center / cover no-repeat;
    }

    .text-wrapper {
        max-width: 48rem;
        padding-block-end: 4rem;
    }

    .accent-img {
        position: relative;
        z-index: 2;
        width: 100%;
        background: var(--bg-image) center / contain repeat;
        height: 3.5rem;

        /* & img {
            width: 100%;
            height: auto;
            object-fit: cover;
        } */
    }

    .sections {
        margin-block-start: var(--space-3xl);

        & > * + * {
            margin-block-start: var(--space-2xl);
        }
    }

    .section {
        &[data-section="regular-singings"] {
            & .grid-12 {
                & .text-wrapper {
                    --grid-col-span: span 6;
                }

                & .image-wrapper {
                    --grid-col-span: 8/13;
                }
            }
        }
    }

    .block {
        & p {
            font-size: var(--step-0);
        }

        &:not(:first-of-type) {
            margin-block-start: var(--space-m);
            padding-block-start: var(--space-m);
            border-block-start: 1px solid var(--brown-5);
        }
    }

    .heading {
        margin-block-end: var(--space-l);
    }

    .featured-image {
        border-radius: 3px;
    }

    @media (max-width: 640px) {
        h1 {
            font-size: var(--step-5);
        }

        .section {
            &[data-section="regular-singings"] {
                & .grid-12 {
                    grid-template-columns: 1fr;

                    & .text-wrapper {
                        --grid-col-span: 1/1;
                    }

                    & .image-wrapper {
                        --grid-col-span: 1/1;
                    }
                }
            }
        }

        .panes {
            --panes-gap: var(--space-s);
            --panes-width: 100% !important;

            &[data-composition="diptych"] {
                --panes-width: 100%;

                &[data-image-offset] {
                    & .text-wrapper {
                        --panes-width: 100%;
                    }

                    & .image-wrapper {
                        --panes-width: 100%;
                    }
                }
            }

            & .text-wrapper {
                order: 1;
            }

            & .image-wrapper {
                order: 2;
            }
        }
    }
</style>
